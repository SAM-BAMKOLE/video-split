{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VideoSplitter",
  "version": "0.4.0",
  "identifier": "com.Bamicole.et.Nova.videosplitter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Video Splitter",
        "width": 1020,
        "height": 760,
        "minWidth": 680,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "app", "dmg", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "resources": ["resources/person_detector.onnx"]
  }
}
